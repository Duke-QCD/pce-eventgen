#!/bin/sh
# Build the maintained models using the currently loaded compiler/dependency stack.
# See nersc/SETUP.md. Model names and arguments after -- pass to local/install.
if [ -z "${NERSC_HOST:-}" ]; then
  echo 'this script should be run on a NERSC machine' >&2
  exit 1
fi
# local/install checks the active Python environment and installs into it.
# Global Common is the setup default; existing environments elsewhere also work.
# NERSC may set BASH_ENV to a profile that changes the active environment.
unset BASH_ENV
export CC="${CC:-cc}" CXX="${CXX:-CC}"
exec "$(dirname "$0")"/../local/install "$@"
