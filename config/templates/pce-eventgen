#!/bin/bash
#SBATCH --account={{ACCOUNT}}
#SBATCH --output={{SLURM_OUTPUT}}
#SBATCH --error={{SLURM_ERROR}}
#SBATCH --qos=regular
#SBATCH --constraint=cpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --time=00:10:00
#SBATCH --license=scratch
#
# Event-generation batch launcher for one NERSC profile, generated by
# nersc/configure_user.py. run_designs.py submits it with
#   sbatch [resource options from [submit]] --export=ALL,RUNDIR=...,NEVENTS=...,MODE=... pce-eventgen
# The #SBATCH resources above are defaults that those sbatch options override.

# Preserve an explicit archive selection from the submission environment (for
# example run_designs.py --archive-root/--archive-base) while loading this profile's paths.
requested_surface_archive_root="${HIC_SURFACE_ARCHIVE_ROOT:-}"
requested_surface_archive_base="${HIC_SURFACE_ARCHIVE_BASE:-}"
if [[ -z "${HIC_PATHS_FILE:-}" ]]; then
    export HIC_PATHS_FILE={{PATHS_FILE}}
fi
echo "[pce-eventgen] Sourcing HIC_PATHS_FILE=${HIC_PATHS_FILE}"
source "$HIC_PATHS_FILE" || exit 1
if [[ -n "$requested_surface_archive_root" ]]; then
    export HIC_SURFACE_ARCHIVE_ROOT="$requested_surface_archive_root"
fi
if [[ -n "$requested_surface_archive_base" ]]; then
    export HIC_SURFACE_ARCHIVE_BASE="$requested_surface_archive_base"
fi

# The site's batch-shell setup initializes conda; stop if activation fails.
module load conda || exit 1
conda activate "$HIC_SOFTWARE_ROOT" || exit 1
export XDG_DATA_HOME="$HIC_SOFTWARE_ROOT/share"
export PYTHONNOUSERSITE=1
module load gsl cpu

export PMI_NO_FORK=1
export PMI_NO_PREINITIALIZE=1
export PMI_MMAP_SYNC_WAIT_TIME=300

job=$NERSC_HOST-$SLURM_JOB_ID
ntasks=${SLURM_NTASKS}

if [[ -z "$RUNDIR" ]]; then
  echo "ERROR: RUNDIR not set. Submit with: sbatch --export=ALL,RUNDIR=/path/to/run_dir pce-eventgen" >&2
  exit 1
fi

# Settings exported by run_designs.py; resources (time, qos, nodes, tasks, CPUs)
# arrive as sbatch options instead because Slurm reads them before this script runs.
DESIGN_ID="${DESIGN_ID:-unknown}"
JOB_INDEX="${JOB_INDEX:-0}"
NEVENTS="${NEVENTS:?NEVENTS must be exported by run_designs.py}"
MODE="${MODE:-hydro}"
LOG_ROOT="${LOG_ROOT:-$HIC_RAW_ROOT/_logs/events}"
RESTORE_ARCHIVES="${RESTORE_ARCHIVES:-false}"
MAX_AFTERBURNER_RETRIES="${MAX_AFTERBURNER_RETRIES:-3}"

case "${RESTORE_ARCHIVES,,}" in
  1|true|yes|y|on)
    if [[ "$MODE" != "afterburner" ]]; then
      echo "ERROR: RESTORE_ARCHIVES=true is only allowed with MODE=afterburner, got MODE=$MODE" >&2
      exit 1
    fi
    ;;
  0|false|no|n|off|"")
    ;;
  *)
    echo "ERROR: Unrecognized RESTORE_ARCHIVES value: $RESTORE_ARCHIVES" >&2
    echo "Use true/false." >&2
    exit 1
    ;;
esac

mkdir -p "$LOG_ROOT"

echo "Running design=${DESIGN_ID} job_index=${JOB_INDEX} nevents=${NEVENTS} mode=${MODE} restore_archives=${RESTORE_ARCHIVES} max_afterburner_retries=${MAX_AFTERBURNER_RETRIES}"
echo "RUNDIR=${RUNDIR}"
echo "LOG_ROOT=${LOG_ROOT}"
echo "SLURM_NNODES=${SLURM_NNODES:-unset} SLURM_NTASKS=${SLURM_NTASKS:-unset} SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-unset}"

srun -K0 run-events-wrapper  \
  --nevents "$NEVENTS" \
  --mode "$MODE" \
  --restore-archives "$RESTORE_ARCHIVES" \
  --max-afterburner-retries "$MAX_AFTERBURNER_RETRIES" \
  --rankvar SLURM_PROCID \
  --rankfmt "{:0${#ntasks}d}" \
  --logfile "$LOG_ROOT/$job.log" \
  "$RUNDIR"
