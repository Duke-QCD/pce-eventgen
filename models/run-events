def touch_marker(path):
    Path(path).write_text(
        f"timestamp={datetime.datetime.now().isoformat()}\n"
        f"hostname={os.uname().nodename}\n"
        f"pid={os.getpid()}\n"
        f"slurm_job_id={os.environ.get('SLURM_JOB_ID', '')}\n"
    )


def remove_file_if_exists(path):
    try:
        os.remove(path)
    except FileNotFoundError:
        pass


def remove_tree_if_exists(path):
    try:
        shutil.rmtree(path)
    except FileNotFoundError:
        pass

def archive_relative_event_path(event_dir):
    """Use the configured archive base, with legacy scratch/tail fallback if unset.

    Identical to models/surface_archive.py:archive_relative_path, which the
    repair and maintenance tools import; this installed runner cannot import it.
    """
    event_dir = Path(event_dir).resolve()
    configured = os.environ.get("HIC_SURFACE_ARCHIVE_BASE")
    if configured:
        expanded = os.path.expandvars(os.path.expanduser(configured))
        if re.search(r'\$(?:[A-Za-z_]\w*|\{[^}]+\})', expanded):
            raise ValueError(f"Unresolved variable in HIC_SURFACE_ARCHIVE_BASE: {configured}")
        base = Path(expanded)
        if not base.is_absolute():
            raise ValueError("HIC_SURFACE_ARCHIVE_BASE must be an absolute path")
        try:
            return event_dir.relative_to(base.resolve())
        except ValueError:
            raise ValueError(f"{event_dir} is outside HIC_SURFACE_ARCHIVE_BASE={base}; "
                             "refusing to change the archive layout") from None
    roots = [os.environ.get(name) for name in ("PSCRATCH", "SCRATCH")]
    for root in roots:
        if root:
            try:
                return event_dir.relative_to(Path(root).expanduser().resolve())
            except ValueError:
                pass
    # Drop the filesystem anchor so the result always stays below the archive root.
    return Path(*event_dir.relative_to(event_dir.anchor).parts[-4:])

def archived_surface_path(event_dir):
    return SURFACE_ARCHIVE_ROOT / archive_relative_event_path(event_dir) / "surface.dat.zst"


def zstd_archive_is_valid(path):
    path = Path(path)
    if not path.is_file() or path.stat().st_size == 0:
        return False
    proc = subprocess.run(
        [str(ZSTD_EXEC), "-t", str(path)],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        universal_newlines=True,
        check=False,
    )
    if proc.returncode != 0:
        logging.warning(
            "invalid zstd archive %s; zstd -t output:\n%s",
            path,
            proc.stdout.strip("\n"),
        )
        return False
    return True


def archived_surface_matches(archive, surface):
    """Compare decompressed bytes before deleting a local surface on a retry."""
    with Path(surface).open("rb") as source, tempfile.TemporaryFile() as errors:
        with subprocess.Popen([str(ZSTD_EXEC), "-dc", str(archive)],
                              stdout=subprocess.PIPE, stderr=errors) as proc:
            try:
                while True:
                    chunk = proc.stdout.read(1024 * 1024)
                    if not chunk:
                        return not source.read(1) and proc.wait() == 0
                    if chunk != source.read(len(chunk)):
                        return False
            finally:
                proc.stdout.close()
                if proc.poll() is None:
                    proc.terminate()
                proc.wait()


def archive_surface_if_possible(event_dir):
    """Archive event_dir/surface.dat to CFS and delete the scratch copy.

    This is deliberately only called by afterburner-terminal paths.  It is
    restart-safe: existing archives must match a present local surface, invalid
    archives are recreated, compression writes to a unique temporary path first,
    and the scratch surface is deleted only after zstd verification succeeds.
    """
    event_dir = Path(event_dir).resolve()
    surface = event_dir / "surface.dat"
    archive = archived_surface_path(event_dir)

    if archive.exists():
        if zstd_archive_is_valid(archive):
            if surface.exists():
                if not surface.is_file() or not archived_surface_matches(archive, surface):
                    raise RuntimeError(
                        f"existing archive does not match local surface; preserving both: "
                        f"{archive} and {surface}"
                    )
                logging.info(
                    "valid archived surface already exists at %s; deleting scratch copy %s",
                    archive,
                    surface,
                )
                remove_file_if_exists(surface)
            else:
                logging.info("valid archived surface already exists at %s", archive)
            return True

        logging.warning("removing invalid archived surface before recreating: %s", archive)
        remove_file_if_exists(archive)

    if not surface.exists():
        logging.info("no surface.dat present to archive for %s", event_dir)
        return False

    if not surface.is_file() or surface.stat().st_size == 0:
        raise RuntimeError(f"surface.dat is missing or empty and cannot be archived safely: {surface}")

    archive.parent.mkdir(parents=True, exist_ok=True)
    tmp_archive = archive.with_name(
        archive.name
        + f".tmp.{os.environ.get('SLURM_JOB_ID', 'nojid')}.{os.getpid()}"
    )
    remove_file_if_exists(tmp_archive)

    try:
        run_cmd(str(ZSTD_EXEC), "-T0", "-q", "-f", "-o", str(tmp_archive), str(surface))
        if not zstd_archive_is_valid(tmp_archive):
            raise RuntimeError(f"zstd verification failed for temporary archive: {tmp_archive}")
        os.replace(tmp_archive, archive)
        if not zstd_archive_is_valid(archive):
            raise RuntimeError(f"zstd verification failed for final archive: {archive}")
        remove_file_if_exists(surface)
        logging.info("archived and removed scratch surface: %s -> %s", surface, archive)
        return True
    except Exception:
        remove_file_if_exists(tmp_archive)
        raise

def restore_surface_from_archive_if_needed(event_dir):
    """Restore event_dir/surface.dat from the mirrored CFS archive if needed.

    This is intended only for explicit afterburner reruns.  If surface.dat is
    already present, nothing is changed.  If it is missing, the mirrored
    surface.dat.zst archive is verified, decompressed to a temporary file inside
    the event directory, checked for nonzero size, and atomically moved into
    place as surface.dat.
    """
    event_dir = Path(event_dir).resolve()
    surface = event_dir / "surface.dat"
    archive = archived_surface_path(event_dir)

    if surface.is_file() and surface.stat().st_size > 0:
        logging.info("surface.dat already present for afterburner: %s", surface)
        return True

    if surface.exists():
        raise RuntimeError(f"surface.dat exists but is not a nonempty regular file: {surface}")

    if not archive.is_file():
        logging.info("surface.dat is missing and no archived surface exists: %s", archive)
        return False

    if not zstd_archive_is_valid(archive):
        raise RuntimeError(f"archived surface exists but failed verification: {archive}")

    tmp_surface = surface.with_name(
        surface.name
        + f".restore_tmp.{os.environ.get('SLURM_JOB_ID', 'nojid')}.{os.getpid()}"
    )
    remove_file_if_exists(tmp_surface)

    try:
        proc = subprocess.run(
            [str(ZSTD_EXEC), "-d", "-q", "-f", "-o", str(tmp_surface), str(archive)],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            universal_newlines=True,
            check=False,
        )
        if proc.returncode != 0:
            raise RuntimeError(
                "failed to restore archived surface with zstd:\n"
                f"archive={archive}\n"
                f"output={proc.stdout.strip()}"
            )
        if not tmp_surface.is_file() or tmp_surface.stat().st_size == 0:
            raise RuntimeError(f"restored temporary surface is missing or empty: {tmp_surface}")
        os.replace(tmp_surface, surface)
        logging.info("restored surface from archive: %s -> %s", archive, surface)
        return True
    except Exception:
        remove_file_if_exists(tmp_surface)
        raise

def prune_files(paths):
    for path in paths:
        remove_file_if_exists(path)

def particle_output_path(event_dir):
    return Path(event_dir) / "particle_lists.oscar"


def final_smash_output_status(event_dir):
    """Return (status, path) for terminal SMASH output state.

    status is "finished" for particle_lists.oscar, "unfinished" for
    particle_lists.oscar.unfinished, "ambiguous" for states requiring
    manual inspection, or None if neither variant exists.  Zero-byte particle
    files are not valid zero-particle events; they are treated as ambiguous
    interrupted/truncated writes.
    """
    finished_path = particle_output_path(event_dir)
    unfinished_path = finished_path.with_name(finished_path.name + ".unfinished")

    nonempty = []
    zero_or_nonregular = []
    for status, path in [
        ("finished", finished_path),
        ("unfinished", unfinished_path),
    ]:
        if not path.exists():
            continue
        if not path.is_file():
            zero_or_nonregular.append(path)
            continue
        try:
            size = path.stat().st_size
        except FileNotFoundError:
            continue
        if size > 0:
            nonempty.append((status, path))
        else:
            zero_or_nonregular.append(path)

    if zero_or_nonregular or len(nonempty) > 1:
        logging.warning(
            "ambiguous particle output state in %s: nonempty=%s invalid_or_zero=%s",
            event_dir,
            [str(p) for _status, p in nonempty],
            [str(p) for p in zero_or_nonregular],
        )
        return "ambiguous", None

    if len(nonempty) == 1:
        return nonempty[0]

    return None, None


def final_smash_output_exists(event_dir):
    status, _ = final_smash_output_status(event_dir)
    return status in {"finished", "unfinished"}


def prepare_smash_tmp_output_dir(system_dir, event_name):
    """
    Return a clean per-event SMASH output directory under a shared root.

    SMASH creates tabulations next to its output directory.  Writing to
    <system_dir>/<SMASH_TMP_ROOT>/<event_name> lets tabulations be reused at
    the system level while the final particle list is moved back into the
    event directory.
    """
    tmp_root = Path(system_dir) / SMASH_TMP_ROOT
    tmp_root.mkdir(parents=True, exist_ok=True)

    tmp_output_dir = tmp_root / event_name
    remove_tree_if_exists(tmp_output_dir)
    tmp_output_dir.mkdir(parents=True, exist_ok=False)
    return tmp_output_dir


def move_smash_output_to_event(tmp_output_dir, event_dir):
    """Move exactly one usable SMASH output from tmp_output_dir to event_dir."""
    tmp_output_dir = Path(tmp_output_dir)
    event_dir = Path(event_dir)

    candidates = []
    invalid_or_zero = []
    for status, src in [
        ("finished", tmp_output_dir / "particle_lists.oscar"),
        ("unfinished", tmp_output_dir / "particle_lists.oscar.unfinished"),
    ]:
        if not src.exists():
            continue
        if not src.is_file():
            invalid_or_zero.append(src)
            continue
        if src.stat().st_size > 0:
            candidates.append((status, src))
        else:
            invalid_or_zero.append(src)

    if invalid_or_zero or len(candidates) > 1:
        raise RuntimeError(
            "ambiguous SMASH output variants in temporary output directory: "
            f"nonempty={[str(p) for _status, p in candidates]} "
            f"invalid_or_zero={[str(p) for p in invalid_or_zero]}"
        )

    if len(candidates) == 1:
        status, src = candidates[0]
        dst = event_dir / src.name
        remove_file_if_exists(dst)
        shutil.move(str(src), str(dst))
        return status, dst

    return None, None

def mark_afterburner_done(event_dir, status, output_path):
    """
    Mark afterburner completion and record whether SMASH produced a finished
    or unfinished particle list.
    """
    Path(Path(event_dir) / AFTERBURNER_DONE).write_text(
        "afterburner_status = {}\n"
        "output = {}\n"
        "timestamp = {}\n"
        "hostname = {}\n"
        "pid = {}\n"
        "slurm_job_id = {}\n".format(
            status,
            output_path,
            datetime.datetime.now().isoformat(timespec="seconds"),
            os.uname().nodename,
            os.getpid(),
            os.getenv("SLURM_JOB_ID", ""),
        )
    )


def hydro_marker_exists(event_dir):
    event_dir = Path(event_dir)
    return (event_dir / HYDRO_DONE).exists()


def acquire_afterburner_lock(event_dir):
    """
    Atomically claim an event for afterburner work.

    The lock is a directory rather than a regular file because mkdir is atomic
    on the shared filesystem.  Stale locks older than
    AFTERBURNER_LOCK_STALE_HOURS are removed and retried once.
    """
    lock_dir = Path(event_dir) / AFTERBURNER_LOCK

    try:
        lock_dir.mkdir()
    except FileExistsError:
        try:
            age_hours = (datetime.datetime.now().timestamp() - lock_dir.stat().st_mtime) / 3600.0
        except FileNotFoundError:
            try:
                lock_dir.mkdir()
            except FileExistsError:
                return False
            touch_marker(lock_dir / "owner.txt")
            return True

        if age_hours <= AFTERBURNER_LOCK_STALE_HOURS:
            return False

        logging.warning("removing stale afterburner lock %s, age %.2f hours", lock_dir, age_hours)
        remove_tree_if_exists(lock_dir)
        try:
            lock_dir.mkdir()
        except FileExistsError:
            return False

    touch_marker(lock_dir / "owner.txt")
    return True


def release_afterburner_lock(event_dir):
    remove_tree_if_exists(Path(event_dir) / AFTERBURNER_LOCK)


def read_afterburner_retry_count(event_dir):
    """Return the persisted afterburner attempt count for this event (0 if none).

    The count survives across run-events invocations and Slurm jobs so a
    fundamentally broken event is not retried forever.
    """
    path = Path(event_dir) / AFTERBURNER_RETRY_COUNT
    try:
        text = path.read_text()
    except FileNotFoundError:
        return 0
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("count"):
            try:
                return int(line.split("=", 1)[1].strip())
            except (IndexError, ValueError):
                return 0
    # Backwards compatible with a bare-integer file.
    try:
        return int(text.strip())
    except ValueError:
        return 0


def write_afterburner_retry_count(event_dir, count):
    Path(Path(event_dir) / AFTERBURNER_RETRY_COUNT).write_text(
        "count = {}\n"
        "timestamp = {}\n"
        "slurm_job_id = {}\n".format(
            count,
            datetime.datetime.now().isoformat(timespec="seconds"),
            os.getenv("SLURM_JOB_ID", ""),
        )
    )


def clear_afterburner_retry_count(event_dir):
    remove_file_if_exists(Path(event_dir) / AFTERBURNER_RETRY_COUNT)


def write_afterburner_failed(event_dir, attempt=None, error=None):
    """Write the afterburner.failed marker with diagnostic context."""
    Path(Path(event_dir) / AFTERBURNER_FAILED).write_text(
        "timestamp = {}\n"
        "hostname = {}\n"
        "pid = {}\n"
        "slurm_job_id = {}\n"
        "attempt = {}\n"
        "error = {}\n".format(
            datetime.datetime.now().isoformat(timespec="seconds"),
            os.uname().nodename,
            os.getpid(),
            os.getenv("SLURM_JOB_ID", ""),
            "" if attempt is None else attempt,
            "" if error is None else repr(str(error))[:500],
        )
    )


def write_archive_failed(event_dir, error=None):
    """Write archive.failed for mandatory surface-archive failures."""
    Path(Path(event_dir) / ARCHIVE_FAILED).write_text(
        "timestamp = {}\n"
        "hostname = {}\n"
        "pid = {}\n"
        "slurm_job_id = {}\n"
        "error = {}\n".format(
            datetime.datetime.now().isoformat(timespec="seconds"),
            os.uname().nodename,
            os.getpid(),
            os.getenv("SLURM_JOB_ID", ""),
            "" if error is None else repr(str(error))[:500],
        )
    )


def clear_archive_failed(event_dir):
    remove_file_if_exists(Path(event_dir) / ARCHIVE_FAILED)


def complete_afterburner_output(event_dir, status, output_path):
    """Finalize an event whose particle output already exists.

    Surface archiving is mandatory for new completions.  Archive failure is a
    post-afterburner failure mode, so it writes archive.failed but does not
    consume the afterburner retry budget or write afterburner.failed.
    """
    event_dir = Path(event_dir)

    # Valid particle output means the afterburner stage itself is no longer the
    # failing stage, even if a previous attempt left stale markers behind.
    remove_file_if_exists(event_dir / AFTERBURNER_FAILED)
    clear_afterburner_retry_count(event_dir)

    try:
        if not archive_surface_if_possible(event_dir):
            raise RuntimeError(
                "mandatory surface archive did not complete; "
                "surface.dat was absent and no valid archive was available"
            )
    except Exception as exc:
        write_archive_failed(event_dir, error=exc)
        logging.exception(
            "mandatory surface archive failed for %s; not writing %s",
            event_dir,
            AFTERBURNER_DONE,
        )
        return False

    clear_archive_failed(event_dir)
    mark_afterburner_done(event_dir, status, output_path)
    return True


def clean_afterburner_workspace(event_dir):
    """Remove afterburner byproducts/scratch before a fresh attempt.

    Only afterburner-stage artifacts are removed; hydro outputs (surface.dat,
    hydro.done) are preserved.  This is called only after confirming no usable
    particle list exists, so nothing reusable is discarded.
    """
    event_dir = Path(event_dir)
    remove_tree_if_exists(event_dir / "results")
    for name in AFTERBURNER_BYPRODUCTS:
        remove_file_if_exists(event_dir / name)
    # Drop any empty/partial particle files that are not usable terminal output.
    for name in ("particle_lists.oscar", "particle_lists.oscar.unfinished"):
        p = event_dir / name
        try:
            if p.is_file() and p.stat().st_size == 0:
                remove_file_if_exists(p)
        except FileNotFoundError:
            pass

